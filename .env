# Expo automatically inlines any EXPO_PUBLIC_* variable at build time — no extra
# package needed. Copy this to .env and adjust for how you're running the app:
#
#   - Android emulator:  http://10.0.2.2:4000/api/v1   (10.0.2.2 = your host machine, from the emulator's point of view)
#   - iOS simulator:     http://localhost:4000/api/v1   (simulator shares the host's network)
#   - Physical device (Expo Go): http://<your-computer's-LAN-IP>:4000/api/v1   (e.g. http://192.168.1.23:4000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://192.168.18.154:4000/api/v1
